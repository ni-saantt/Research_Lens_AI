# Groq Cloud API Key for Server-Side LLM Multi-Agent Inference
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=

# Server Port (default: 3000)
PORT=3000

# Optional Model Overrides (defaults configured in src/config/modelConfig.ts)
# GROQ_HEAVY_MODEL=llama-3.3-70b-versatile
# GROQ_LIGHT_MODEL=llama-3.1-8b-instant
